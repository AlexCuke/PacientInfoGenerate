{
  "manifest_version": 3,
  "name": "Облтех — тестовый пациент",
  "version": "0.3.0",
  "minimum_chrome_version": "112",
  "description": "Генерация тестовых пациентов и регистрация стационарного случая.",
  "permissions": ["storage"],
  "optional_host_permissions": [
    "http://registration.dev.m99.dzm/*",
    "http://registration.test.m99.dzm/*",
    "http://registration-tpak.m15.dzm/*"
  ],
  "icons": {
    "16": "icons/patient-16.png",
    "32": "icons/patient-32.png",
    "48": "icons/patient-48.png",
    "128": "icons/patient-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Тестовый пациент",
    "default_icon": {
      "16": "icons/patient-16.png",
      "32": "icons/patient-32.png"
    }
  }
}
